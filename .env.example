# =============================================================================
# Hôtel Le Relais du Centre — variables d'environnement
# Copier ce fichier en .env.local et renseigner les valeurs.
# .env.local n'est JAMAIS versionné (voir .gitignore).
# =============================================================================

# --- Supabase ----------------------------------------------------------------
# Les deux premières sont exposées au navigateur (préfixe NEXT_PUBLIC_) :
# c'est normal et sans danger, les policies RLS font le travail de protection.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ⚠️ CONTOURNE TOUTES LES RLS. Serveur uniquement (webhook de paiement, cron).
# Ne jamais préfixer par NEXT_PUBLIC_, ne jamais committer.
SUPABASE_SERVICE_ROLE_KEY=

# --- Paiement ----------------------------------------------------------------
# mock             : simulateur local, pour les tests automatisés et la démo
# cinetpay_sandbox : clés sk_test_, aucun compte marchand requis
# cinetpay_live    : clés sk_live_, exige le compte marchand KYC de l'hôtel
PAYMENT_PROVIDER=mock
CINETPAY_API_KEY=
CINETPAY_SITE_ID=
CINETPAY_SECRET_KEY=

# --- Notifications (Zavu : WhatsApp + repli SMS + e-mail) --------------------
ZAVU_API_KEY=
# Identifiant de l'expéditeur déclaré dans Zavu (numéro WhatsApp professionnel
# de l'hôtel + domaine e-mail authentifié). Facultatif : à défaut, Zavu utilise
# l'expéditeur par défaut du projet.
ZAVU_SENDER_ID=
# Adresse et numéro de l'hôtel qui reçoivent la copie de chaque réservation
HOTEL_NOTIFICATION_EMAIL=
HOTEL_NOTIFICATION_WHATSAPP=

# --- Application -------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Protège la route /api/cron/expire-holds contre les appels extérieurs
CRON_SECRET=

# Template WhatsApp approuvé par Meta pour la confirmation de réservation.
# Tant qu'il est absent, la confirmation part par SMS (aucune contrainte Meta).
ZAVU_WHATSAPP_TEMPLATE_CONFIRMATION=
